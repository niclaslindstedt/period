node_modules/
.expo/
dist/
.env
*.log

# The packed web build, produced by `npm run bundle` from the web app in
# `../src`. Generated, never committed — but it MUST exist before a build or the
# wrapper ships with no cycle log inside it. The root `.easignore` is what keeps
# it in the EAS upload; CI regenerates it (see .github/workflows/native.yml).
assets/webroot.zip

# Generated by `expo prebuild`. Regenerated from app.config.js and the config
# plugins, so it is the source of truth for nothing.
#
# Anchored with a leading slash so only the prebuild output at this level is
# ignored: a bare `ios/` matches at EVERY level, and would silently swallow a
# hand-written `ios/` folder inside a local module.
/ios/
/android/

# Store credentials — never committed.
*.p8
*.p12
*.jks
*.mobileprovision
play-service-account.json
